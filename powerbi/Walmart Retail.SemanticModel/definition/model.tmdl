model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Store","Department","Week","Store Week","Department Week","ExportFolder"]

ref table Store
ref table Department
ref table Week
ref table 'Store Week'
ref table 'Department Week'

ref cultureInfo en-US

